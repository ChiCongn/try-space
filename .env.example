# Root example env
NODE_ENV=development

# API
API_PORT=3000
API_BASE_URL=http://localhost:3000/api/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Web
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_URL=http://localhost:5173
VITE_LOG_LEVEL=debug
VITE_LOG_TO_CONSOLE=true
VITE_LOG_ENDPOINT=
VITE_LOG_SAMPLE_RATE=1
VITE_RELEASE_VERSION=local
VITE_CLOUDINARY_CLOUD_NAME=
VITE_MODEL_VIEWER_VERSION=4.2.0

# Local/remote 3D model settings
VITE_DEFAULT_MODEL_URL=/models/sample-chair.glb
VITE_MODEL_SOURCE=sketchfab
